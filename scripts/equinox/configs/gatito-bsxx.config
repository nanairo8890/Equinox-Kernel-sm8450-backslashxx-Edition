# Gatito root stack for Equinox, backslashxx edition: backslashxx/KernelSU (v3.3.1+52,
# UAPI 6) + SUSFS v2.4.0 + NoMount v2.3.0 + BBR. Uses backslashxx's own Kconfig names,
# not FinaSU's (CONFIG_KSU_DYNAMIC_MANAGER etc. do not exist here).
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
# sucompat (su for apps/shell) is only built with one of the two hook backends, and
# their defaults only kick in for KSU=m. Built-in needs one picked explicitly:
# syscall table tampering, the one backslashxx documents as Clang CFI compliant.
CONFIG_KSU_TAMPER_SYSCALL_TABLE=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER=y

# BBR by default instead of Equinox's CUBIC
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y

# NoMount (maxsteeel): built-in VFS path redirection
CONFIG_NOMOUNT=y

# Kernel release of this edition: 5.10.269-Nanairo-backslashxx
CONFIG_LOCALVERSION="-Nanairo-backslashxx"
